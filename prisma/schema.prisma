// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// MULTI-TENANT CORE MODELS
// ============================================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  googleId        String?   @unique
  appleId         String?   @unique
  firstName       String?
  lastName        String?
  avatar          String?
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  lastLogin       DateTime?
  // Stamped into every session JWT. Incrementing it invalidates all tokens
  // issued before the bump — that's how password reset and "log out
  // everywhere" revoke sessions that are otherwise stateless.
  tokenVersion    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  orgMembers              OrgMember[]
  auditLogs               AuditLog[]
  apiKeys                 ApiKey[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@index([email])
  @@index([createdAt])
}

model Organization {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  logoUrl         String?
  billingEmail    String?
  // Amazon brand name, as it appears in product titles. Used by Brand
  // Analytics to identify the org's own ASINs (identifyBrandASINs) and to
  // label generated reports. Nullable — orgs that never set it fall back to
  // the catalog report's ASIN list, which is less complete but still works.
  brandName       String?
  // Optional Slack incoming-webhook URL — when set, the alert evaluation
  // worker posts a summary message to this channel alongside email delivery.
  slackWebhookUrl String?
  tier            SubscriptionTier @default(BASIC)
  billingStatus   BillingStatus    @default(ACTIVE)
  trialEndsAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  members               OrgMember[]
  amazonCredentials     AmazonCredential[]
  sellerProfiles        SellerProfile[]
  auditLogs             AuditLog[]
  subscriptions         Subscription[]
  usageMetrics          UsageMetric[]
  listingOptimizations  ListingOptimization[]
  bulkListingBatches    BulkListingBatch[]
  reportJobs            ReportJob[]
  campaignRules         CampaignRule[]
  campaignAlerts        CampaignAlert[]
  brandAnalyticsReports BrandAnalyticsReport[]
  invitations           OrgInvitation[]

  @@index([slug])
  @@index([billingStatus])
  @@index([createdAt])
}

model OrgMember {
  id             String    @id @default(cuid())
  orgId          String
  userId         String
  role           OrgRole   @default(MEMBER)
  joinedAt       DateTime  @default(now())
  invitedAt      DateTime?
  invitedBy      String?
  // Per-user opt-in for campaign-alert email notifications. Defaults true so
  // org admins keep getting alerts unless they explicitly opt out.
  notifyOnAlerts Boolean   @default(true)

  // Relations
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

/// A pending invitation to join an organization.
///
/// Membership is never created directly by an admin — the invited person has to
/// accept while signed in as the address that was invited. That acceptance is
/// the consent step: without it, any admin could pull a stranger's account into
/// their org (and become the default tenant for anyone who had no org yet).
model OrgInvitation {
  id         String    @id @default(cuid())
  orgId      String
  /// Normalised address the invitation was issued to. Acceptance requires the
  /// signed-in user's email to match this exactly.
  email      String
  role       OrgRole   @default(MEMBER)
  /// Random bearer token embedded in the emailed link.
  token      String    @unique
  invitedBy  String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
  @@index([expiresAt])
}

// ============================================================================
// AMAZON INTEGRATION MODELS
// ============================================================================

model AmazonCredential {
  id            String           @id @default(cuid())
  orgId         String
  refreshToken  String // Encrypted at rest
  marketplaceId String           @default("ATVPDKIKX0DER")
  region        String           @default("NA")
  connectedAt   DateTime         @default(now())
  expiresAt     DateTime?
  lastUsed      DateTime?
  status        CredentialStatus @default(ACTIVE)
  encryptedData String? // JSON blob for additional encrypted fields

  // Relations
  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, marketplaceId])
  @@index([orgId])
  @@index([status])
}

model SellerProfile {
  id             String    @id @default(cuid())
  orgId          String
  profileId      String
  profileName    String
  accountId      String?
  accountName    String?
  countryCode    String
  primaryCountry String
  merchantToken  String? // Encrypted
  isDefault      Boolean   @default(false)
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, profileId])
  @@index([orgId])
  @@index([isDefault])
}

// ============================================================================
// LISTING OPTIMIZATION MODELS
// ============================================================================

model ListingOptimization {
  id                      String             @id @default(cuid())
  orgId                   String
  batchId                 String? // Links to BulkListingBatch when created via bulk endpoint
  asin                    String
  sku                     String
  originalTitle           String
  optimizedTitle          String?
  originalBullets         String[]
  optimizedBullets        String[]
  originalDescription     String
  optimizedDescription    String?
  originalGenericKeyword  String?
  optimizedGenericKeyword String?
  keywords                String[]
  aiModel                 String             @default("claude")
  status                  OptimizationStatus @default(PENDING)
  errorMessage            String?
  publishedAt             DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Relations
  org   Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  batch BulkListingBatch? @relation(fields: [batchId], references: [id])

  @@index([orgId])
  @@index([batchId])
  @@index([asin])
  @@index([sku])
  @@index([status])
  @@index([createdAt])
}

model BulkListingBatch {
  id        String    @id @default(cuid())
  orgId     String
  batchRef  String    @unique // Client-facing UUID (jobId equivalent)
  total     Int
  completed Int       @default(0)
  failed    Int       @default(0)
  status    JobStatus @default(PENDING)
  model     String    @default("gemini")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  org   Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items ListingOptimization[]

  @@index([orgId])
  @@index([batchRef])
  @@index([status])
}

// ============================================================================
// REPORTING & ANALYTICS MODELS
// ============================================================================

model ReportJob {
  id           String     @id @default(cuid())
  orgId        String
  jobId        String     @unique
  type         ReportType
  status       JobStatus  @default(PENDING)
  profileId    String?
  dateFrom     DateTime
  dateTo       DateTime
  result       Json? // Report data
  errorMessage String?
  createdAt    DateTime   @default(now())
  completedAt  DateTime?

  // Relations
  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([status])
  @@index([createdAt])
}

model BrandAnalyticsReport {
  id              String                   @id @default(cuid())
  orgId           String
  reportType      BrandAnalyticsReportType
  reportingPeriod String // 'WEEKLY' | 'MONTHLY' | 'QUARTERLY'
  periodStart     DateTime
  periodEnd       DateTime
  amazonReportId  String? // SP-API reportDocumentId for traceability
  status          JobStatus                @default(PENDING)
  rawData         Json // parsed rows; shape matches existing CSV parser output
  error           String?
  fetchedAt       DateTime                 @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, reportType, periodStart, periodEnd])
  @@index([orgId, reportType, periodEnd])
  @@index([status])
}

// ============================================================================
// BILLING & SUBSCRIPTION MODELS
// ============================================================================

model Subscription {
  id                 String             @id @default(cuid())
  orgId              String             @unique
  subscriptionId     String? // Razorpay subscription ID (sub_xxx)
  tier               SubscriptionTier
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  renewalDate        DateTime
  cancelledAt        DateTime?
  cancelReason       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([orgId])
  @@index([status])
  @@index([subscriptionId])
}

model Invoice {
  id                String        @id @default(cuid())
  subscriptionId    String
  externalInvoiceId String        @unique // Razorpay payment ID (pay_xxx)
  amount            Int // in paise (smallest INR unit)
  currency          String        @default("USD")
  status            InvoiceStatus @default(DRAFT)
  paidAt            DateTime?
  dueDate           DateTime
  createdAt         DateTime      @default(now())

  // Relations
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
}

model UsageMetric {
  id                String   @id @default(cuid())
  orgId             String
  month             DateTime // First day of month
  listingsOptimized Int      @default(0)
  apiCalls          Int      @default(0)
  reportsGenerated  Int      @default(0)
  bulkOperations    Int      @default(0)
  // image-optimizer.js has called trackUsage(orgId, 'imagesOptimized') since it
  // shipped, against a column that did not exist. Prisma rejected every call
  // and trackUsage swallowed the error, so the counter read zero forever and
  // nothing said why.
  imagesOptimized   Int      @default(0)

  // Relations
  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, month])
  @@index([orgId])
}

// ============================================================================
// CAMPAIGN AUTOMATION MODELS
// ============================================================================

model CampaignRule {
  id           String    @id @default(cuid())
  orgId        String
  name         String
  profileId    String
  // Condition
  metric       String // acos | roas | ctr | spend | clicks | impressions
  condition    String // gt | lt | gte | lte
  threshold    Float
  // Action
  action       String // increase_budget | decrease_budget | pause | enable
  adjustment   Float     @default(10) // % for budget changes; ignored for pause/enable
  lookbackDays Int       @default(14)
  isActive     Boolean   @default(true)
  schedule     String? // null=manual | 'daily' | 'twice_daily' | 'weekly'
  lastRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  executions RuleExecution[]

  @@index([orgId])
  @@index([isActive])
  @@index([schedule])
}

model RuleExecution {
  id            String   @id @default(cuid())
  ruleId        String
  orgId         String
  status        String // success | partial | failed | skipped
  affectedCount Int      @default(0)
  changes       Json? // [{ campaignId, name, field, oldValue, newValue }]
  error         String?
  executedAt    DateTime @default(now())

  rule CampaignRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([orgId])
  @@index([executedAt])
}

// ============================================================================
// CAMPAIGN ALERT MODELS
// ============================================================================

model CampaignAlert {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  metric    String // acos | spend | roas | ctr | clicks | impressions
  condition String // gt | lt | gte | lte
  threshold Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fires AlertFire[]

  @@index([orgId])
  @@index([isActive])
}

model AlertFire {
  id           String   @id @default(cuid())
  alertId      String
  orgId        String
  campaignId   String
  campaignName String
  metricValue  Float
  isRead       Boolean  @default(false)
  triggeredAt  DateTime @default(now())

  alert CampaignAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([alertId])
  @@index([isRead])
  @@index([triggeredAt])
}

// ============================================================================
// AUDIT & SECURITY MODELS
// ============================================================================

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  action     String // e.g., "listing_optimized", "credentials_updated"
  resource   String // e.g., "listing", "amazon_credential"
  resourceId String?
  changes    Json? // Before/after values
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  // Relations
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  name      String
  keyHash   String    @unique
  lastUsed  DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ============================================================================
// ENUMS
// ============================================================================

enum OrgRole {
  ADMIN
  MEMBER
  VIEWER
}

/// Idempotency + audit ledger for inbound provider webhooks (e.g. Razorpay).
/// Not org-scoped: events are provider-level and resolved to an org while processing.
model WebhookEvent {
  id          String             @id @default(cuid())
  provider    String             @default("razorpay")
  eventId     String             @unique // provider event id (x-razorpay-event-id) or body hash
  eventType   String
  status      WebhookEventStatus @default(RECEIVED)
  attempts    Int                @default(0)
  error       String?
  receivedAt  DateTime           @default(now())
  processedAt DateTime?

  @@index([provider, eventType])
  @@index([status])
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

/// Durable record of background jobs that permanently failed (all BullMQ retries
/// exhausted). Not org-scoped — operational/ops-level (the job's `data` may carry
/// an orgId). Used for inspection, alerting, and manual replay.
model DeadLetterJob {
  id           String    @id @default(cuid())
  queue        String
  jobId        String
  name         String?
  data         Json?
  attemptsMade Int       @default(0)
  failedReason String?
  stack        String?
  replayedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([queue])
  @@index([createdAt])
}

enum SubscriptionTier {
  BASIC
  PRO
  ENTERPRISE
  CUSTOM
}

enum BillingStatus {
  ACTIVE
  PAUSED
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  // Checkout has started but no payment is confirmed yet. The row exists only so
  // the Razorpay webhook can find it by subscriptionId — syncSubscriptionFromRazorpay
  // bails if there is no row. PENDING grants nothing: requireActiveSubscription
  // admits ACTIVE and PAST_DUE only.
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  FAILED
  REFUNDED
}

enum CredentialStatus {
  ACTIVE
  EXPIRED
  REVOKED
  INVALID
}

enum OptimizationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PUBLISHED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ReportType {
  CAMPAIGN_PERFORMANCE
  SEARCH_TERMS
  KEYWORD_ANALYSIS
  LISTING_HEALTH
  REVENUE_SUMMARY
}

enum BrandAnalyticsReportType {
  SQP_BRAND
  SQP_ASIN
  TOP_SEARCH_TERMS
  REPEAT_PURCHASE
  MARKET_BASKET
  ITEM_COMPARISON_ALT_PURCHASE
  DEMOGRAPHICS
  BRAND_CATALOG_PERFORMANCE
}
