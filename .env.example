# ============================================================================
# GOOGLE SSO
# ============================================================================
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: https://optimizer.hivemindnestor.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ============================================================================
# APPLE SSO (Sign in with Apple)
# ============================================================================
# 1. Apple Developer → Certificates, IDs & Profiles → Identifiers
#    - Create an App ID with "Sign In with Apple" enabled.
#    - Create a Services ID — its identifier becomes APPLE_CLIENT_ID
#      (e.g. com.hivemindnestor.optimizer.signin). Configure it with:
#        Domain:     optimizer.hivemindnestor.com
#        Return URL: https://optimizer.hivemindnestor.com/api/auth/apple/callback
# 2. Apple Developer → Keys → "+" → enable Sign In with Apple, download the .p8.
#    - Key ID becomes APPLE_KEY_ID.
#    - Team ID is shown top-right of the Apple Developer console.
# 3. APPLE_PRIVATE_KEY = full contents of the .p8 file. For multi-line env
#    storage, replace real newlines with the literal string "\n" — the server
#    converts them back at load time.
APPLE_CLIENT_ID=com.example.signin
APPLE_TEAM_ID=ABCDE12345
APPLE_KEY_ID=ABCDE12345
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Public URL of the frontend app (used by Google/Apple OAuth callback redirect)
FRONTEND_URL=https://optimizer.hivemindnestor.com

# ============================================================================
# Anthropic API key for Claude AI integration
ANTHROPIC_API_KEY=your_anthropic_key_here

# Amazon Advertising API credentials.
# These back the legacy single-tenant singleton client in services/amazon-ads.js;
# per-org credentials are stored encrypted in the DB via /api/sp-oauth/ads-start
# and take priority over these.
AMAZON_ADS_CLIENT_ID=your_amazon_ads_client_id
AMAZON_ADS_CLIENT_SECRET=your_amazon_ads_client_secret
AMAZON_ADS_REFRESH_TOKEN=your_amazon_ads_refresh_token
# Default profile ID used by getCampaignMetrics (find yours via the Profiles API)
AMAZON_DEFAULT_PROFILE_ID=your_profile_id
# Override marketplace endpoint if needed (defaults to NA production)
# AMAZON_MARKETPLACE_ENDPOINT=https://advertising-api.amazon.com

# Google AI API key for Gemini/Google AI services
GOOGLE_AI_API_KEY=your_google_ai_key_here

# Cloudinary cloud name (found in your Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Cloudinary API key (found in your Cloudinary dashboard)
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Cloudinary API secret (found in your Cloudinary dashboard)
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cloudinary upload preset for unsigned uploads
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ============================================================================
# REDIS (BullMQ job queue)
# ============================================================================
# Redis connection URL for BullMQ reporting job queue
REDIS_URL=redis://localhost:6379

# Port the server will listen on
PORT=3000

# Node environment: development | production | test
NODE_ENV=development

# ============================================================================
# DATABASE CONFIGURATION (Prisma + PostgreSQL)
# ============================================================================
# PostgreSQL connection string for Prisma ORM
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/amaiop_dev
DATABASE_URL=postgresql://user:password@localhost:5432/amaiop_dev

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT session secret for signing authentication tokens
SESSION_SECRET=your_secure_random_secret_here_min_32_chars

# Hard cap on how long a session may live since the user last actually logged
# in. Tokens expire after 8h and /auth/refresh slides that window forward, but
# refreshing cannot push a session past this cap — after it, re-authentication
# is required. Optional; defaults to 7.
SESSION_ABSOLUTE_MAX_DAYS=7

# AES-256-GCM encryption key for Amazon credentials stored in DB
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_key_here

# ============================================================================
# MULTI-TENANT CONFIGURATION
# ============================================================================
# Frontend URL for CORS and redirects
FRONTEND_URL=http://localhost:5173

# ============================================================================
# RAZORPAY BILLING
# ============================================================================
# Get your keys from Razorpay Dashboard → Settings → API Keys
# RAZORPAY_KEY_ID=rzp_live_...          (or rzp_test_... for test mode)
# RAZORPAY_KEY_SECRET=your_key_secret
# Webhook secret — set in Razorpay Dashboard → Webhooks → Secret
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Razorpay Plan IDs — create plans in Razorpay Dashboard → Subscriptions → Plans
# RAZORPAY_PLAN_BASIC=plan_...
# RAZORPAY_PLAN_PRO=plan_...
# RAZORPAY_PLAN_ENTERPRISE=plan_...

# ============================================================================
# MARKETING SITE INTEGRATION
# ============================================================================
# Shared secret for server-to-server claim-payment calls from hivemindnestor.com.
# Generate with: openssl rand -hex 32
# Must match MARKETING_CLAIM_SECRET in the marketing site's env vars.
# MARKETING_CLAIM_SECRET=your_64_char_hex_secret

# ============================================================================
# AMAZON SP-API OAUTH (Solution Provider Network)
# ============================================================================
# Register your app at https://sellercentral.amazon.com/apps/manage
# All three values come from your SP-API application in Developer Central.
# SP_API_CLIENT_ID=amzn1.application-oa2-client.xxxxx
# SP_API_CLIENT_SECRET=your_sp_api_client_secret
# SP_SOLUTION_ID=amzn1.sellerapps.app.xxxxx   (Application ID from Developer Central)
# Redirect URI — must match exactly what's registered in your SP-API app:
# SP_OAUTH_REDIRECT_URI=https://yourdomain.com/api/sp-oauth/callback
# Local dev: use an ngrok tunnel, e.g. https://abc123.ngrok.io/api/sp-oauth/callback

# ============================================================================
# EMAIL (nodemailer — required for email verification & password reset)
# ============================================================================
# When SMTP_HOST is unset, falls back to Ethereal (captures emails locally,
# no real delivery) — ideal for dev. Set these for staging/production.
#
# Recommended: Resend (resend.com) — works in India, 3 000 free emails/month
#   1. Sign up at resend.com → API Keys → Create API key
#   2. Add & verify your sending domain under Domains
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx   ← your Resend API key
#   SMTP_FROM=AMAIOP <noreply@yourdomain.com>
#
# Alternatives:
#   Brevo (brevo.com): SMTP_HOST=smtp-relay.brevo.com  SMTP_USER=<login email>
#   SendGrid:          SMTP_HOST=smtp.sendgrid.net      SMTP_USER=apikey

# ============================================================================
# STORAGE PATHS
# ============================================================================
# Where Brand Analytics CSV uploads are written (per-org subdirectories).
# Unset → <cwd>/data/brand-analytics, correct for local development.
#
# On Railway the container filesystem is EPHEMERAL: uploads written to the
# default location are lost on every redeploy. Attach a volume and point this
# at its mount path to make them durable.
#   BA_DATA_DIR=/data/brand-analytics
