# Anthropic API key for Claude AI integration
ANTHROPIC_API_KEY=your_anthropic_key_here

# Amazon Advertising API credentials
AMAZON_CLIENT_ID=your_amazon_client_id
AMAZON_CLIENT_SECRET=your_amazon_client_secret
AMAZON_REFRESH_TOKEN=your_amazon_refresh_token
# Default profile ID used by getCampaignMetrics (find yours via the Profiles API)
AMAZON_DEFAULT_PROFILE_ID=your_profile_id
# Override marketplace endpoint if needed (defaults to NA production)
# AMAZON_MARKETPLACE_ENDPOINT=https://advertising-api.amazon.com

# Google AI API key for Gemini/Google AI services
GOOGLE_AI_API_KEY=your_google_ai_key_here

# Cloudinary cloud name (found in your Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Cloudinary API key (found in your Cloudinary dashboard)
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Cloudinary API secret (found in your Cloudinary dashboard)
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cloudinary upload preset for unsigned uploads
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Port the server will listen on
PORT=3000

# Node environment: development | production | test
NODE_ENV=development
